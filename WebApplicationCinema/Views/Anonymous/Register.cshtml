@model BaseViewModel
@{
    Layout = "_LoginLayout"; ;
    string mainPage = "/";
    ViewData["title"] = Model.Title;
    string mountainImage = "/images/logo_mountain.png";
}

  <body data-path-to-root="../" data-include-products="false" class="u-body u-xl-mode" data-lang="ru"><header class="u-border-2 u-border-grey-75 u-clearfix u-header u-header" id="header"><div class="u-clearfix u-sheet u-valign-middle-lg u-valign-middle-md u-valign-middle-sm u-valign-middle-xs u-sheet-1">
        <nav class="u-menu u-menu-one-level u-offcanvas u-menu-1" role="navigation">
          <div class="menu-collapse" style="font-size: 1rem; letter-spacing: 0px;">
            <a class="u-button-style u-custom-left-right-menu-spacing u-custom-padding-bottom u-custom-top-bottom-menu-spacing u-hamburger-link u-nav-link u-text-active-palette-1-base u-text-hover-palette-2-base" href="#" tabindex="-1" aria-label="Open menu" aria-controls="913b">
              <svg class="u-svg-link" viewBox="0 0 24 24"><use xlink:href="#menu-hamburger"></use></svg>
              <svg class="u-svg-content" version="1.1" id="menu-hamburger" viewBox="0 0 16 16" x="0px" y="0px" xmlns:xlink="http://www.w3.org/1999/xlink" xmlns="http://www.w3.org/2000/svg"><g><rect y="1" width="16" height="2"></rect><rect y="7" width="16" height="2"></rect><rect y="13" width="16" height="2"></rect>
</g></svg>
            </a>
          </div>
          <div class="u-custom-menu u-nav-container">
            <ul role="menubar" class="u-nav u-unstyled u-nav-1"><li role="none" class="u-nav-item"><a role="menuitem" class="u-button-style u-nav-link u-text-active-palette-1-base u-text-hover-palette-2-base" href=@mainPage style="padding: 10px 20px;">Главная</a>
                        </li>
                        <li role="none" class="u-nav-item">
                            <a role="menuitem" class="u-button-style u-nav-link u-text-active-palette-1-base u-text-hover-palette-2-base" href=@Model.Login_outPage style="padding: 10px 20px;">@Model.Login_outText</a>
</li><li role="none" class="u-nav-item"><a role="menuitem" class="u-button-style u-nav-link u-text-active-palette-1-base u-text-hover-palette-2-base" href=@Model.Profile_panelPage style="padding: 10px 20px;">@Model.Profile_panelText</a>
</li></ul>
          </div>
          <div class="u-custom-menu u-nav-container-collapse" id="913b" role="region" aria-label="Menu panel">
            <div class="u-black u-container-style u-inner-container-layout u-opacity u-opacity-95 u-sidenav">
              <div class="u-inner-container-layout u-sidenav-overflow">
                <div class="u-menu-close" tabindex="-1" aria-label="Close menu"></div>
                <ul class="u-align-center u-nav u-popupmenu-items u-unstyled u-nav-2" role="menubar"><li role="none" class="u-nav-item"><a role="menuitem" class="u-button-style u-nav-link" href=@mainPage>Главная</a>
                                </li>
                                <li role="none" class="u-nav-item">
                                    <a role="menuitem" class="u-button-style u-nav-link" href=@Model.Login_outPage>@Model.Login_outText</a>
</li><li role="none" class="u-nav-item"><a role="menuitem" class="u-button-style u-nav-link" href=@Model.Profile_panelPage>@Model.Profile_panelText</a>
</li></ul>
              </div>
            </div>
            <div class="u-black u-menu-overlay u-opacity u-opacity-70"></div>
          </div>
            </nav><span class="u-file-icon u-icon u-icon-1" data-href=@mainPage data-page-id="115758581" title="start"><img src=@mountainImage alt=""></span>
      </div></header>
    <section class="u-clearfix u-gradient u-section-1" id="block-1">
      <div class="u-clearfix u-sheet u-valign-middle u-sheet-1">
        <div class="u-form u-gradient u-form-1">
          <form action="" class="u-clearfix u-form-spacing-10 u-form-vertical u-inner-form" source="custom" name="form" style="padding: 10px;" method="post">
            <div class="u-form-email u-form-group u-label-top">
              <label for="email-a3ee" class="u-label u-label-1">Эл. почта</label>
              <input type="email" placeholder="Введите адрес электронной почты" id="email-a3ee" name="email" class="u-input u-input-rectangle u-radius u-input-1" required="required">
            </div>
            <div class="u-form-group u-label-top">
              <label for="password-register" class="u-label u-label-1">Пароль (не менее 12 символов)</label>
              <input type="password" placeholder="Придумайте пароль" id="password-register" name="password" minlength="12" autocomplete="new-password" class="u-input u-input-rectangle u-radius u-input-1" required="required">
            </div>
            <div class="u-align-center u-form-group u-form-submit u-label-top">
                <input type="submit" value="Отправить" class="u-active-palette-1-dark-2 u-border-none u-btn u-btn-round u-btn-submit u-button-style u-hover-palette-1-light-2 u-radius u-btn-1">
            </div>
            <div class="u-form-send-message u-form-send-success">Пароль задаётся при регистрации и не отправляется по электронной почте.</div>
            <div class="u-form-send-error u-form-send-message"> Отправка не удалась. Пожалуйста, исправьте ошибки и попробуйте еще раз. </div>
          </form>
        </div>
      </div>
    </section>
    
    
    
    
    <footer class="u-align-center u-clearfix u-container-align-center u-footer u-grey-80 u-footer" id="footer"><div class="u-clearfix u-sheet u-valign-middle u-sheet-1">
        <p class="u-small-text u-text u-text-variant u-text-1">© Кинотеатр "Эверест", Сапрыкин Матвей АИБ-23-2 </p>
      </div></footer>
    <section class="u-backlink u-clearfix u-grey-80"></section>
  
</body>