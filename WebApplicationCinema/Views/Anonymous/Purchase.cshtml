    <script>
        document.addEventListener('DOMContentLoaded', function() {
            const selectedSeats = new Set();
            const tempSelectedSeats = new Set();

            const emailInput = document.querySelector('input[name="email"]');
            const seatRows = document.querySelectorAll('.u-list-11');

            seatRows.forEach((row, rowIndex) => {
            // const seatsInRow = row.querySelectorAll('.u-btn.u-btn-round.u-palette-4-dark-1');
            // Обработчик клика для мест
                const seatButtons = row.querySelectorAll('a[name="btn"]');

                seatButtons.forEach(button => {
                    button.addEventListener('click', function(e) {
                        e.preventDefault();
                        if(tempSelectedSeats.size >= 5 && !tempSelectedSeats.has(this)) {
                            alert("Вы пытаетесь выбрать слишком много мест!")
                            return;
                        }

                        // Получаем номер ряда (индекс + 1, так как ряды обычно нумеруются с 1)
                        const rowNumber = rowIndex + 1;

                        // Получаем номер места (упрощенно - текст кнопки)
                        const seatNumber = this.textContent.trim();

                        // Формируем полный идентификатор места (ряд-место)
                        const fullSeatId = `${rowNumber}-${seatNumber}`;

                        if (tempSelectedSeats.has(this)) {
                            // Если место уже выбрано - отменяем выбор
                            tempSelectedSeats.delete(this);
                            selectedSeats.delete(fullSeatId);
                            this.classList.remove('selected-seat');
                            this.style.backgroundColor = ''; // Возвращаем исходный цвет
                        } else {
                            // Если место не выбрано - добавляем
                            tempSelectedSeats.add(this);
                            selectedSeats.add(fullSeatId);
                            this.classList.add('selected-seat');
                            this.style.backgroundColor = '#41807C'; // Подсвечиваем
                        }
                    });
                });
            });

            const seatSRows = document.querySelectorAll('.u-list-2');
            
            seatSRows.forEach((row, rowIndex) => {
            // const seatsInRow = row.querySelectorAll('.u-btn.u-btn-round.u-palette-4-dark-1');
            // Обработчик клика для мест
                const seatButtons = row.querySelectorAll('a[name="btn"]');

                seatButtons.forEach(button => {
                    button.addEventListener('click', function(e) {
                        e.preventDefault();                       
                        if(tempSelectedSeats.size > 5) {
                            alert("Вы пытаетесь выбрать слишком много мест!")
                            return;
                        }
                        // Получаем номер ряда (индекс + 1, так как ряды обычно нумеруются с 1)
                        const rowNumber = rowIndex + 1;

                        // Получаем номер места (упрощенно - текст кнопки)
                        const seatNumber = this.textContent.trim();

                        // Формируем полный идентификатор места (ряд-место)
                        const fullSeatId = `${rowNumber}-${seatNumber}`;

                        if (tempSelectedSeats.has(this)) {
                            // Если место уже выбрано - отменяем выбор
                            tempSelectedSeats.delete(this);
                            selectedSeats.delete(fullSeatId);
                            this.classList.remove('selected-seat');
                            this.style.backgroundColor = ''; // Возвращаем исходный цвет
                        } else {
                            // Если место не выбрано - добавляем
                            tempSelectedSeats.add(this);
                            selectedSeats.add(fullSeatId);
                            this.classList.add('selected-seat');
                            this.style.backgroundColor = '#41807C'; // Подсвечиваем
                        }
                    });
                });
            });
    
            // Обработчики для кнопок бронирования и покупки
            const bookBtn = document.querySelector('.u-btn.u-palette-3-light-1');
            const buyBtn = document.querySelector('.u-btn.u-palette-2-light-1');
    
            if (bookBtn) {
                bookBtn.addEventListener('click', function(e) {
                    e.preventDefault();
                    processSeats('Бронь', selectedSeats);
                });
            }
    
            if (buyBtn) {
                buyBtn.addEventListener('click', function(e) {
                    e.preventDefault();
                    processSeats('Покупка', selectedSeats);
                });
            }
    
            // Функция обработки выбранных мест
            function processSeats(action, seats) {
                console.log(seats.size); // REMOVE
                if (seats.size === 0) {
                    alert('Пожалуйста, выберите хотя бы одно место!');
                    return;
                }

                if (emailInput.value === "") {
                    alert('Пожалуйста, введите email!');
                    return;
                }

                // fetch('/checkAuth')
                // .then(response => {
                //    response.json()
                //    .then(json => {
                //        json.
                //    });
                // });
                // const seatsList = Array.from(seats).join(', ');
                // console.log(`${action} мест: ${seatsList}`);
        
                // Здесь можно добавить AJAX-запрос для отправки данных на сервер
                // Например:

                fetch('/reserving', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                    },
                    body: JSON.stringify({
                        action: action,
                        session: @{@Model.Session.ID},
                        seats: Array.from(seats),
                        email: emailInput.value
                    })
                })
                .then(response => {
                    console.log(response);
                    response.json().then(json => {
                        if (json.isEmailValid){
                            // console.log("redir")
                            if (action === "Бронь"){
                                alert("Билет отправлен на вашу почту");
                            }
                            window.location.href = json.redirect;
                        }
                        else{
                            alert("Пожалуйста введите корректный email!");
                        }
                    });
                    // window.location.href = "/";
                    // obj = JSON.parse(response.json)
                    // console.log(obj)
                })
                .catch(error => {
                    console.error('Ошибка:', error);
                });
       
        
                // alert(`${action} мест: ${seatsList}\n(проверьте консоль для деталей)`);
            }

});
    </script>

