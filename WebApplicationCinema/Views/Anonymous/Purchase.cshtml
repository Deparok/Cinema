        <div class="u-clearfix u-sheet u-valign-middle u-sheet-1">
            @{
                for(int i = 0; i < Model.SeatTable.Count; i++)
                {
                     
                    int secondSeats = Model.SeatTable[i].Count / 2;
                    int firstSeats = Model.SeatTable[i].Count - secondSeats; // Сюда лучше больше

                    int seatNumber = 0;
                    <div class="custom-expanded u-align-center u-list u-list-11">
                        <div class="u-repeater u-repeater-1">
                            @for (int j = 1; j < 11; j++)
                            {
                                // if (j < 11 - firstSeats)
                                // {
                                //     <div class="u-container-style u-list-item u-radius u-repeater-item u-shape-round u-list-item-1">
                                //         <div class="u-container-layout u-similar-container u-container-layout-1"></div>
                                //     </div>
                                //     continue;
                                // }
                                
                                seatNumber++;

                                switch(Model.SeatTable[i][j - 1].State)
                                {
                                    case SeatState.Free:
                                        <div class="u-container-style u-list-item u-repeater-item u-shape-rectangle u-list-item-1">
                                            <div class="u-container-layout u-similar-container u-valign-top u-container-layout-1">
                                                <a name="btn" class="u-border-none u-btn u-btn-round u-button-style u-palette-4-dark-1 u-radius u-text-body-color u-btn-1">@seatNumber</a>
                                            </div>
                                        </div>
                                        break;

                                    case SeatState.Booked:
                                        <div class="u-container-style u-custom-item u-list-item u-palette-3-light-1 u-radius u-repeater-item u-shape-round u-list-item-20"> 
                                            <div class="u-container-layout u-similar-container u-container-layout-20">
                                                <p class="u-align-center u-text u-text-color-var u-text-default u-text-20">@seatNumber</p>
                                            </div>
                                        </div>
                                        break;

                                    case SeatState.Bought:
                                        <div class="u-container-style u-custom-item u-list-item u-palette-2-light-1 u-radius u-repeater-item u-shape-round u-list-item-1">
                                            <div class="u-container-layout u-similar-container u-container-layout-1">
                                                <p class="u-align-center u-text u-text-color-var u-text-default u-text-1">@seatNumber</p>
                                            </div>
                                        </div>
                                        break;

                                    case SeatState.None:
                                        <div class="u-container-style u-list-item u-radius u-repeater-item u-shape-round u-list-item-1">
                                            <div class="u-container-layout u-similar-container u-container-layout-1"></div>
                                        </div>
                                        seatNumber--;
                                        break;

                                    default:
                                        break;
                                }
                            }
                        </div>
                    </div>

                    <div class="custom-expanded u-align-center u-list u-list-2">
                        <div class="u-repeater u-repeater-2">
                            @for(int j = firstSeats + 1; j < firstSeats + secondSeats + 1; j++)
                            {
                                seatNumber++;

                                // if (seatNumber + 1 > Model.SeatTable[i].Count)
                                // {
                                //     break;
                                // }

                                switch(Model.SeatTable[i][j - 1].State)
                                {
                                    case SeatState.Free:
                                        <div class="u-container-style u-list-item u-repeater-item u-shape-rectangle u-list-item-1">
                                            <div class="u-container-layout u-similar-container u-valign-top u-container-layout-1">
                                                <a name="btn" class="u-border-none u-btn u-btn-round u-button-style u-palette-4-dark-1 u-radius u-text-body-color u-btn-1">@seatNumber</a>
                                            </div>
                                        </div>
                                        break;

                                    case SeatState.Booked:
                                        <div class="u-container-style u-custom-item u-list-item u-palette-3-light-1 u-radius u-repeater-item u-shape-round u-list-item-20"> 
                                            <div class="u-container-layout u-similar-container u-container-layout-1">
                                                <p class="u-align-center u-text u-text-color-var u-text-default u-text-1">@seatNumber</p>
                                            </div>
                                        </div>
                                        break;

                                    case SeatState.Bought:
                                        <div class="u-container-style u-custom-item u-list-item u-palette-2-light-1 u-radius u-repeater-item u-shape-round u-list-item-1">
                                            <div class="u-container-layout u-similar-container u-container-layout-1">
                                                <p class="u-align-center u-text u-text-color-var u-text-default u-text-1">@seatNumber</p>
                                            </div>
                                        </div>
                                        break;

                                    case SeatState.None:
                                        <div class="u-container-style u-list-item u-radius u-repeater-item u-shape-round u-list-item-1">
                                            <div class="u-container-layout u-similar-container u-container-layout-1"></div>
                                        </div>
                                        seatNumber--;
                                        break;

                                    default:
                                        break;
                                }
                            }
                        </div>
                    </div>
                }
            }
