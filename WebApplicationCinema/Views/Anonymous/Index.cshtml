@model IndexViewModel
@{
    // Layout = null;
    string mainPage = "/";
    ViewData["title"] = Model.Title;
    string mountainImage = "/images/logo_mountain.png";
    string timingPage = "/timing";
}

  <body data-home-page="start.html" data-home-page-title="start" data-path-to-root="./" data-include-products="false" class="u-body u-xl-mode" data-lang="ru"><header class="u-border-2 u-border-grey-75 u-clearfix u-header u-header" id="header"><div class="u-clearfix u-sheet u-valign-middle-lg u-valign-middle-md u-valign-middle-sm u-valign-middle-xs u-sheet-1">
        <nav class="u-menu u-menu-one-level u-offcanvas u-menu-1" role="navigation">
          <div class="menu-collapse" style="font-size: 1rem; letter-spacing: 0px;">
            <a class="u-button-style u-custom-left-right-menu-spacing u-custom-padding-bottom u-custom-top-bottom-menu-spacing u-hamburger-link u-nav-link u-text-active-palette-1-base u-text-hover-palette-2-base" href="#" tabindex="-1" aria-label="Open menu" aria-controls="913b">
              <svg class="u-svg-link" viewBox="0 0 24 24"><use xlink:href="#menu-hamburger"></use></svg>
              <svg class="u-svg-content" version="1.1" id="menu-hamburger" viewBox="0 0 16 16" x="0px" y="0px" xmlns:xlink="http://www.w3.org/1999/xlink" xmlns="http://www.w3.org/2000/svg"><g><rect y="1" width="16" height="2"></rect><rect y="7" width="16" height="2"></rect><rect y="13" width="16" height="2"></rect>
</g></svg>
            </a>
          </div>
          <div class="u-custom-menu u-nav-container">
            <ul role="menubar" class="u-nav u-unstyled u-nav-1"><li role="none" class="u-nav-item"><a role="menuitem" class="u-button-style u-nav-link u-text-active-palette-1-base u-text-hover-palette-2-base" href="./" style="padding: 10px 20px;">Главная</a>
                        </li>
                        <li role="none" class="u-nav-item">
                            <a role="menuitem" class="u-button-style u-nav-link u-text-active-palette-1-base u-text-hover-palette-2-base" href=@Model.Login_outPage style="padding: 10px 20px;">@Model.Login_outText</a>
</li><li role="none" class="u-nav-item"><a role="menuitem" class="u-button-style u-nav-link u-text-active-palette-1-base u-text-hover-palette-2-base" href=@Model.Profile_panelPage style="padding: 10px 20px;">@Model.Profile_panelText</a>
</li></ul>
          </div>
          <div class="u-custom-menu u-nav-container-collapse" id="913b" role="region" aria-label="Menu panel">
            <div class="u-black u-container-style u-inner-container-layout u-opacity u-opacity-95 u-sidenav">
              <div class="u-inner-container-layout u-sidenav-overflow">
                <div class="u-menu-close" tabindex="-1" aria-label="Close menu"></div>
                <ul class="u-align-center u-nav u-popupmenu-items u-unstyled u-nav-2" role="menubar"><li role="none" class="u-nav-item"><a role="menuitem" class="u-button-style u-nav-link" href=@mainPage>Главная</a>
                                </li>
                                <li role="none" class="u-nav-item">
                                    <a role="menuitem" class="u-button-style u-nav-link" href=@Model.Login_outPage>@Model.Login_outText</a>
</li><li role="none" class="u-nav-item"><a role="menuitem" class="u-button-style u-nav-link" href=@Model.Profile_panelPage>@Model.Profile_panelText</a>
</li></ul>
              </div>
            </div>
            <div class="u-black u-menu-overlay u-opacity u-opacity-70"></div>
          </div>
        </nav><span class="u-file-icon u-icon u-icon-1" data-href=@mainPage data-page-id="115758581" title="start"><img src=@mountainImage alt=""></span>
      </div></header>
    <section class="u-clearfix u-gradient u-image u-shading u-section-1" id="block-1" data-image-width="400" data-image-height="265">
      <div class="u-clearfix u-sheet u-valign-bottom-lg u-valign-bottom-md u-valign-bottom-sm u-valign-bottom-xs u-sheet-1">
        <h2 class="u-text u-text-palette-3-dark-2 u-text-1">Добро пожаловать в кинотеатр Эверест! </h2>
        <h4 class="u-text u-text-palette-3-dark-2 u-text-2">Насладитесь лучшими фильмами</h4>
            <a href="./#carousel-1801" data-page-id="115758581" class="u-align-center u-btn u-btn-round u-button-style u-custom-font u-heading-font u-radius u-btn-1">К фильмам </a>
      </div>
    </section>
    <section class="u-carousel u-slide u-block-77a8-1" id="carousel-1801" data-interval="5000" data-u-ride="carousel">
      <ol class="u-absolute-hcenter u-carousel-indicators u-block-77a8-2">
        <li data-u-target="#carousel-1801" class="u-active u-grey-30 u-shape-circle" style="width: 10px; height: 10px;" data-u-slide-to="0"></li>
        @{
            if (Model.Movies.Count > 0)
            {
                for (int i = 1; i < Model.Movies.Count; i++)
                {
                    <li data-u-target="#carousel-1801" class="u-grey-30 u-shape-circle" style="width: 10px; height: 10px;" data-u-slide-to="@i.ToString()"></li>
                }
            }
        }
        </ol>
        <div class="u-carousel-inner" role="listbox">
            @* <div class="u-active u-carousel-item u-clearfix u-section-2-1">
                <div class="u-clearfix u-sheet u-sheet-1"></div>
            </div> *@
            @{
                if (Model.Movies.Count > 0)
                {
                    string activity = "u-active";

                    for (int i = 0; i < Model.Movies.Count; i++)
                    {                        
                        if (i > 0 && activity != String.Empty)
                            activity = String.Empty;

                        <div class="@activity u-align-center u-carousel-item u-clearfix u-container-align-center u-valign-bottom-xl u-valign-top-lg u-valign-top-md u-valign-top-sm u-valign-top-xs u-section-2-2">
                            <img class="u-expanded-width u-image u-image-1" src=@Model.Movies[i].PosterPath data-href=@timingPage?movie=@Model.Movies[i].ID data-image-width="5000" data-image-height="3316" /> <!-- data-page-id="2447729488" title="purchase"-->
                            <h2 class="u-align-center u-text u-text-default u-text-1">@Model.Movies[i].Name</h2>
                            <p class="u-align-center u-large-text u-text u-text-default u-text-variant u-text-2">@Model.Movies[i].Description&nbsp;</p>
                        </div>
                    }
                }
                else
                {
                    <div class="u-active u-align-center u-carousel-item u-clearfix u-container-align-center u-valign-bottom-xl u-valign-top-lg u-valign-top-md u-valign-top-sm u-valign-top-xs u-section-2-2">
                        <img class="u-expanded-width u-image u-image-1" src="/images/noimage.jpg" data-image-width="5000" data-image-height="3316">
                        <h2 class="u-align-center u-text u-text-default u-text-1">Нет доступных фильмов</h2>
                        <p class="u-align-center u-large-text u-text u-text-default u-text-variant u-text-2">Нет доступных фильмов&nbsp;</p>
                    </div>
                }
            }
            @* <div class="u-align-center u-carousel-item u-clearfix u-container-align-center u-valign-bottom-xl u-valign-top-lg u-valign-top-md u-valign-top-sm u-valign-top-xs u-section-2-2">
          <img class="u-expanded-width u-image u-image-1" src="images/3a3u65oUrfBXbc.jpeg" data-image-width="5000" data-image-height="3316" data-href="Anonymous/timing.html" data-page-id="2447729488" title="purchase">
          <h2 class="u-align-center u-text u-text-default u-text-1">Название</h2>
          <p class="u-align-center u-large-text u-text u-text-default u-text-variant u-text-2">Красивое описание красивого фильма, наверное, не знаю, а может быть это вообще мультфильм или начало какого-нибудь сериала&nbsp;</p>
        </div>
        <div class="u-align-center u-carousel-item u-clearfix u-container-align-center u-valign-top-lg u-valign-top-md u-valign-top-sm u-valign-top-xs u-section-2-3">
          <img class="u-expanded-width u-image u-image-1" src="images/ehO8.jpeg" data-image-width="5760" data-image-height="3840" data-href="Anonymous/timing.html" data-page-id="2447729488" title="purchase">
          <h2 class="u-align-center u-text u-text-default u-text-1">Название</h2>
          <p class="u-align-center u-large-text u-text u-text-default u-text-variant u-text-2">Коротенькое описание</p>
        </div>
        <div class="u-align-center u-carousel-item u-clearfix u-valign-top u-section-2-4">
          <img class="u-expanded-width u-image u-image-1" src="images/3a3u65oUrfBXbc.jpeg" data-image-width="5000" data-image-height="3316" data-href="Anonymous/timing.html" data-page-id="2447729488" title="purchase">
          <h2 class="u-align-center u-text u-text-default u-text-1">Название</h2>
          <p class="u-align-center u-large-text u-text u-text-default u-text-variant u-text-2">Красивое описание красивого фильма, наверное, не знаю, а может быть это вообще мультфильм или начало какого-нибудь сериала ебануто длинное описание, ебнутся просто, ахуеть какой размер у него, просто пиздец</p>
        </div> *@
      </div>  @*u-absolute-vcenter*@
      <a class="u-carousel-control u-carousel-control-prev u-icon-rectangle u-text-grey-30 u-block-77a8-3" href="#carousel-1801" role="button" data-u-slide="prev"><span aria-hidden="true">
          <svg class="u-svg-link" viewBox="0 0 477.175 477.175"><path d="M145.188,238.575l215.5-215.5c5.3-5.3,5.3-13.8,0-19.1s-13.8-5.3-19.1,0l-225.1,225.1c-5.3,5.3-5.3,13.8,0,19.1l225.1,225
                    c2.6,2.6,6.1,4,9.5,4s6.9-1.3,9.5-4c5.3-5.3,5.3-13.8,0-19.1L145.188,238.575z"></path></svg></span><span class="sr-only">Previous</span>
      </a>
      <a class="u-carousel-control u-carousel-control-next u-icon-rectangle u-text-grey-30 u-block-77a8-4" href="#carousel-1801" role="button" data-u-slide="next"><span aria-hidden="true">
          <svg class="u-svg-link" viewBox="0 0 477.175 477.175"><path d="M360.731,229.075l-225.1-225.1c-5.3-5.3-13.8-5.3-19.1,0s-5.3,13.8,0,19.1l215.5,215.5l-215.5,215.5
                    c-5.3,5.3-5.3,13.8,0,19.1c2.6,2.6,6.1,4,9.5,4c3.4,0,6.9-1.3,9.5-4l225.1-225.1C365.931,242.875,365.931,234.275,360.731,229.075z"></path></svg></span><span class="sr-only">Следующий</span>
      </a>
    </section>
    
    
    
    
    <footer class="u-align-center u-clearfix u-container-align-center u-footer u-grey-80 u-footer" id="footer"><div class="u-clearfix u-sheet u-valign-middle u-sheet-1">
        <p class="u-small-text u-text u-text-variant u-text-1">© Кинотеатр "Эверест", Сапрыкин Матвей АИБ-23-2 </p>
      </div></footer>
    <section class="u-backlink u-clearfix u-grey-80"> This <a href="https://nicepage.com/html-templates">HTML Template</a> was created with Nicepage 
    </section>
  
</body>