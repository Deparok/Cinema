    <script>
            document.addEventListener('DOMContentLoaded', function() {
            // Элементы формы
            const movieSelect = document.getElementById('select-b803');
            const hallSelect = document.getElementById('select-a6aa');
            const sessionStartInput = document.querySelector('input[name="session_start"]');
            const freeTimeInput = document.getElementById('text-755d');
            const sessionEndInput = document.querySelector('input[name="session_end"]');
            const sessionForm = document.querySelector('form[name="session_form"]');

            // Загружаем список фильмов с сервера
            function loadMovies() {
                const selectedDate = sessionStartInput.value;

                if (!selectedDate) {
                    freeTimeInput.value = 'Сначала выберите дату и зал';
                    return;
                }

                const dateOnly = selectedDate.substring(0, 10);

                fetch(`/giveawayMovies?date=${dateOnly}`)
                    .then(response => response.json())
                    .then(data => {
                        // Очищаем и заполняем select
                        movieSelect.innerHTML = '';
                        // const defaultOption = document.createElement('option');
                        // defaultOption.value = '';
                        // defaultOption.textContent = 'Выберите фильм';
                        // movieSelect.appendChild(defaultOption);

                        data.forEach(movie => {
                            const option = document.createElement('option');
                            option.value = movie.id;
                            option.textContent = `${movie.name} - ${movie.year}`;
                            movieSelect.appendChild(option);
                        });
                    })
                    .catch(error => console.error('Ошибка загрузки фильмов:', error));
            }

            // Загружаем список залов с сервера
            function loadHalls() {
                const selectedDate = sessionStartInput.value;

                if (!selectedDate) {
                    freeTimeInput.value = 'Сначала выберите дату и зал';
                    return;
                }

                const dateOnly = selectedDate.substring(0, 10);

                fetch(`/giveawayHalls?date=${dateOnly}`)
                    .then(response => response.json())
                    .then(data => {
                        // Очищаем и заполняем select
                        hallSelect.innerHTML = '';
                        // const defaultOption = document.createElement('option');
                        // defaultOption.value = '';
                        // defaultOption.textContent = 'Выберите зал';
                        // hallSelect.appendChild(defaultOption);

                        data.forEach(hall => {
                            const option = document.createElement('option');
                            option.value = hall.id;
                            option.textContent = hall.name;
                            hallSelect.appendChild(option);
                        });
                    })
                    .catch(error => console.error('Ошибка загрузки залов:', error));
            }

            // Загружаем свободное время (как в предыдущем коде)
            function loadFreeTime() {
                const selectedDate = sessionStartInput.value;
                const hallId = hallSelect.value;

                if (!selectedDate || !hallId) {
                    freeTimeInput.value = 'Сначала выберите дату и зал';
                    return;
                }

                const dateOnly = selectedDate.substring(0, 10);

                fetch(`/todayFreeTimes?date=${dateOnly}&hall=${hallId}`)
                    .then(response => response.json())
                    .then(data => {
                        freeTimeInput.value = data.join(', ') || 'Нет свободного времени';
                    })
                    .catch(error => {
                        console.error('Ошибка загрузки времени:', error);
                        freeTimeInput.value = 'Ошибка загрузки данных';
                    });
            }

            // Запускаем загрузку данных при загрузке страницы
            

            // Слушаем изменения в выборе зала и даты
            hallSelect.addEventListener('change', loadFreeTime);
            sessionStartInput.addEventListener('change', loadFreeTime);
            // sessionEndInput.addEventListener('change', checkTimeIntervals);
            sessionForm.addEventListener('submit', function(e) {
                e.preventDefault();

                if (sessionEndInput.value && sessionStartInput.value) {
                    const endTime = new Date(`2000-01-01T${sessionEndInput.value}`);
                    const startTime = new Date(`2000-01-01T${sessionStartInput.value}`);

                    if (startTime > endTime) {
                        sessionEndInput.value = "";
                        alert("Время окончания выбрано неверно");
                        return;
                    }

                    const durationMinutes = (end - start) / (1000 * 60)

                    fetch("/giveawayFilm", {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                    },
                    body: JSON.stringify({
                        id: movieSelect.value
                        })
                    })
                    .then(response => {
                        response.json()
                        .then(json => {
                            if (json.time > durationMinutes) {
                                sessionEndInput.value = "";
                                alert('Продолжительность фильма больше длительности сеанса');
                                return;
                            }
                        })
                    });
                }
                this.submit();
            });
        const selectButtons = document.querySelectorAll('[class*="u-btn-"][class*="u-border-palette-1-base"]');
        const deleteButton = document.querySelector('.u-btn-19');
        const selectedItems = new Set();

        selectButtons.forEach(button => {
            button.addEventListener('click', function(e) {
                e.preventDefault();

                // const this.closest("name['movie_id']")
                // Находим родительский элемент, который представляет элемент для удаления
                const itemElement = this.closest('.u-container-layout');
                if (!itemElement) return;

                // Получаем идентификатор элемента (нужно адаптировать под вашу структуру)
                const itemId = itemElement.querySelector('h5').textContent.trim();

                if (selectedItems.has(itemId)) {
                    selectedItems.delete(itemId);
                    this.classList.remove('u-palette-1-base', 'u-text-hover-white');
                    this.classList.add('u-text-body-color');
                } else {
                    selectedItems.add(itemId);
                    this.classList.add('u-palette-1-base', 'u-text-hover-white');
                    this.classList.remove('u-text-body-color');
                }
            });
        });

        // Обработчик для кнопки удаления
        if (deleteButton) {
            deleteButton.addEventListener('click', function(e) {
                e.preventDefault();

                if (selectedItems.size === 0) {
                    alert('Выберите хотя бы один элемент для удаления');
                    return;
                }

                // Отправка данных на сервер
                fetch('/delete', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                    },
                    body: JSON.stringify({
                        items: Array.from(selectedItems)
                    })
                })
                .then(response => response.json())
                .then(data => {
                    if (data.success) {
                        alert('Элементы успешно удалены');
                        // Обновляем страницу или удаляем элементы из DOM
                        location.reload();
                    } else {
                        alert('Ошибка при удалении: ' + data.message);
                    }
                })
                .catch(error => {
                    console.error('Error:', error);
                    alert('Произошла ошибка при отправке запроса');
                });
            });
        }
            loadMovies();
            loadHalls();
        });
    </script>
