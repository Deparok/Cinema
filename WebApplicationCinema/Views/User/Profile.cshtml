        <div class="u-clearfix u-sheet u-valign-middle-lg u-valign-middle-md u-valign-middle-sm u-valign-middle-xs" style="min-height: @{@Model.SectionLength}px;">
        <div class="u-expanded-width u-list u-list-1">
          <div class="u-repeater u-repeater-1" style="min-height: @{@Model.RepeaterLength}px;">
            @{
                if (!Model.HasMovies)
                {
                     <div class="u-container-style u-list-item u-repeater-item">
                        <div class="u-container-layout u-similar-container u-container-layout-1">
                            <h2 style="text-align: center; text-justify: auto;">Вы еще ничего не приобрели </h2>
                            <a href="/" style="padding-left: 40%;">Посмотреть фильмы </a>
                        </div>
                    </div>
                }
                foreach (IGrouping<(Session, Movie), Ticket> group in Model.OrderedMonster)
                {
                    decimal totalPrice = (group.Key.Item1.Overprice + group.Key.Item2.Price) * (decimal)group.ToList().Count;
                    StringBuilder url = new StringBuilder("/download?");
                    List<Ticket> tickets = group.ToList();
                    for (int i = 0; i < tickets.Count; i++)
                        url.Append($"[{i}]={tickets[i].ID}");

                    <div class="u-container-style u-list-item u-repeater-item">
                        <div class="u-container-layout u-similar-container u-container-layout-1">
                            <img class="u-image u-image-default u-image-1" src=@group.Key.Item2.PosterPath alt="" data-image-width="1920" data-image-height="1080">
                            <h2 class="u-text u-text-default u-text-1">@group.Key.Item2.Name </h2>
                            <p class="u-large-text u-text u-text-default u-text-variant u-text-2">Количество купленных билетов: @tickets.Count</p>
                            <p class="u-large-text u-text u-text-variant u-text-3">Дата: @group.Key.Item1.Date.ToShortDateString()<br/>Время: @group.Key.Item1.StartTime.ToShortTimeString()</p>
                            <a href="@url" class="u-btn u-btn-round u-button-style u-hover-palette-2-base u-palette-3-base u-radius u-btn-1">
                                <span class="u-icon u-icon-1"><svg class="u-svg-content" viewBox="0 0 512 512" x="0px" y="0px" style="width: 1em; height: 1em;"><path d="M382.56,233.376C379.968,227.648,374.272,224,368,224h-64V16c0-8.832-7.168-16-16-16h-64c-8.832,0-16,7.168-16,16v208h-64    c-6.272,0-11.968,3.68-14.56,9.376c-2.624,5.728-1.6,12.416,2.528,17.152l112,128c3.04,3.488,7.424,5.472,12.032,5.472    c4.608,0,8.992-2.016,12.032-5.472l112-128C384.192,245.824,385.152,239.104,382.56,233.376z"></path><path d="M432,352v96H80v-96H16v128c0,17.696,14.336,32,32,32h416c17.696,0,32-14.304,32-32V352H432z"></path></svg></span>&nbsp;Скачать билеты
                            </a>
                            <div class="u-align-center u-clearfix u-group-elements u-group-elements-1">
                                <span class="u-file-icon u-icon u-icon-2"><img src=@moneyImage alt=""></span>
                                <p class="u-large-text u-text u-text-default u-text-variant u-text-4">@totalPrice</p>
                                <p class="u-large-text u-text u-text-default u-text-variant u-text-5">Стоимость билетов: </p>
                            </div>
                        </div>
                    </div>
                }
